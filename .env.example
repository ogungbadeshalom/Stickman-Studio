# ============================================================
#  Stickman Studio — environment configuration
#  Copy to ".env" and fill in your values:  cp .env.example .env
# ============================================================

# --- Authentication ---
# Path to your service-account key JSON (must have Vertex AI User role).
# Alternatively run `gcloud auth application-default login` and leave blank.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Google Cloud project ---
GCP_PROJECT_ID=my-gcp-project-id
GCP_LOCATION=us-central1

# --- GCS bucket used to stage Veo image->video jobs (no gs:// prefix) ---
# Veo reads input images and writes output videos via GCS.
GCS_STAGING_BUCKET=my-stickman-staging-bucket

# --- Model IDs (override only if you have access to other versions) ---
GEMINI_MODEL=gemini-1.5-pro-002
IMAGEN_GENERATE_MODEL=imagen-3.0-generate-002
IMAGEN_CAPABILITY_MODEL=imagen-3.0-capability-001
VEO_MODEL=veo-2.0-generate-001

# --- Generation tuning ---
SCENE_COUNT=5            # number of scenes to break the script into
VIDEO_SECONDS=5          # 4-5s per clip
RETRY_MAX_ATTEMPTS=6     # auto-retry attempts on rate limit / transient errors
RETRY_BASE_DELAY=4       # seconds; exponential backoff base
LOG_LEVEL=INFO

# --- ZENN storyboard / pacing (phase1_script.py) ---
ZENN_WRITER_MODE=levels   # storyboard writer: levels | flat
ZENN_CHARACTER_FILE=character.json  # JSON profile for the locked protagonist look
ZENN_BACKGROUND=full-bleed simple flat-color background that matches the setting
ZENN_ASPECT=horizontal 16:9  # composition hint appended to prompts
ZENN_LOCK_MODE=text       # 'text' = short character desc in every prompt; 'ref' = RFC image
ZENN_MAX_PROMPT_WORDS=140 # warn when a prompt exceeds this many words
SCENE_COUNT=100           # number of scenes to break the script into
BEAT_REPAIR_ROUNDS=2      # repair rounds for failing visual beats
LINT_REPAIR_ROUNDS=1      # repair rounds for story linter findings
QA_MIN_MATCH=4            # QA: min keyword coverage for a scene image to pass
QA_MIN_CHAR=4             # QA: min matching chars before counting a keyword
ZENN_APPEND_NARRATION=0  # 1 = append narration verbatim to prompt (usually 0)

# --- Image QA (qa_images.py) ---
# (QA_MIN_MATCH / QA_MIN_CHAR defined above in the ZENN block)
ZENN_REF_IMAGE=assets/character_ref.png  # reference image for ZENN_LOCK_MODE=ref character consistency
